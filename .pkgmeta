# Packaging config for BigWigsMods/packager.
# The repo root IS the addon folder, so package-as names the folder inside the zip.
package-as: VendorSearch

# No library externals to fetch, so skip the nolib variant.
enable-nolib-creation: no

manual-changelog: CHANGELOG.md

# Development-only files that should not ship to users. Media/ is NOT ignored --
# it holds the icon the .toc points at. art/ holds the full-resolution source and
# the CurseForge page copy, none of which belongs in a user's download.
ignore:
  - .github
  - tests
  - art
  - .gitattributes
  - .gitignore
  - .pkgmeta
